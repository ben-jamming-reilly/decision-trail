# Omit DATABASE_URL to use the read-only seeded walkthrough.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/recall_knowledge
RECALL_API_KEY=
RECALL_WEBHOOK_SECRET=whsec_base64_encoded_secret
RECALL_REGION=us-west-2
# Stable ngrok origin for local webhooks, without a trailing slash.
PUBLIC_API_BASE_URL=https://your-static-domain.ngrok-free.app
DEMO_MODE=true
OPENAI_API_KEY=
# Optional. Defaults to gpt-5-mini.
OPENAI_MODEL=gpt-5-mini
